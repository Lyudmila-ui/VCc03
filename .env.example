# Скопируйте этот файл в .env и подставьте свой ключ из личного кабинета RouterAI.
# НИКОГДА не коммитьте .env с реальным ключом в Git!
ROUTERAI_API_KEY=sk-your-routerai-key-here

# Текстовая модель для классификации и генерации контента (без префикса "openai/" —
# фабрика llm_factory.py добавит его сама).
ROUTERAI_TEXT_MODEL=openai/openai/gpt-6.1-sol

# Мультимодальная (vision) модель для OCR-агента.
# Альтернативы: google/gemma-3-27b-it, qwen/qwen3.7-flash
ROUTERAI_VISION_MODEL=google/gemma-3-27b-it
